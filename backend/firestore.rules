rules_version = '2';

// Dhikr — Firestore security rules.
//
// The entire cloud is one collection. Each signed-in person owns exactly one document in it,
// named after their account id, containing nothing but numbers:
//
//   contributions/{uid}   { total, todayTotal, todayEpochDay, updatedAt }
//
// No name, no email, no record of which dhikr was said — all of that stays on the device. What
// these rules have to guarantee is narrow and checkable: you may write your own document and
// nobody else's, your total may not go backwards, and it may not be absurd.
//
// Reads are open to any signed-in user because the worldwide figure is a server-side sum() over
// this collection, and Firestore evaluates rules for aggregation queries too. What that exposes
// is a random account id and a number.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function wellFormed() {
      let d = request.resource.data;
      return d.keys().hasOnly(['total', 'todayTotal', 'todayEpochDay', 'updatedAt'])
        && d.total is int
        && d.total >= 0
        // A ceiling on any single person's contribution. Counting a billion dhikr by hand would
        // take several lifetimes, so anything above it is a broken client or a dishonest one, and
        // either way it should not be allowed to move the worldwide figure.
        && d.total <= 1000000000
        && d.todayTotal is int
        && d.todayTotal >= 0
        && d.todayTotal <= d.total
        && d.todayEpochDay is int
        && d.todayEpochDay > 0;
    }

    // A total is a running lifetime figure, so it only ever climbs. This turns a replayed or
    // reordered write — an old total arriving after a newer one — into a no-op rather than a
    // silent regression of somebody's contribution.
    function neverDecreases() {
      return request.resource.data.total >= resource.data.total;
    }

    match /contributions/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && wellFormed();
      allow update: if isOwner(uid) && wellFormed() && neverDecreases();

      // Contributions are permanent, matching the app itself: nothing it records can be deleted.
      allow delete: if false;
    }

    // Everything else is denied. There is no other collection, and no client has any business
    // creating one.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
