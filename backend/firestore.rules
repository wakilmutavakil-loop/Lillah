rules_version = '2';

// Dhikr — Firestore security rules.
//
// Two invariants matter here:
//
//   1. A user can only ever write their own contributions.
//   2. No client can write a total. Totals are produced only by the aggregation function, which
//      runs with Admin privileges and bypasses these rules.
//
// Everything else follows from those.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Fields the server owns. A client that tries to set one is rejected outright rather than
    // having it quietly ignored, so a tampered build fails loudly instead of appearing to work.
    function touchesServerFields(data) {
      return data.diff(resource.data).affectedKeys()
        .hasAny(['total', 'todayTotal', 'todayEpochDay', 'appliedOps']);
    }

    match /users/{uid} {
      // A profile is readable only by its owner. Nothing about one user is exposed to another;
      // the worldwide board is built from the aggregate document, never from scanning users.
      allow read: if isOwner(uid);

      // Creating a profile must not arrive with a total already on it.
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(
             ['total', 'todayTotal', 'todayEpochDay', 'appliedOps']
           );

      allow update: if isOwner(uid) && !touchesServerFields(request.resource.data);

      // Accounts are not deleted from the client. Removing one would orphan its contribution in
      // the global total; account deletion is handled server-side, out of band.
      allow delete: if false;

      match /ops/{opId} {
        allow read: if isOwner(uid);

        // Operations are append-only and immutable. Immutability is what makes the client's
        // idempotency key meaningful: a retry rewrites an identical document and the aggregation
        // function, which folds each document in exactly once, is unaffected.
        allow create: if isOwner(uid) && validOperation();
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data)
                                           .affectedKeys().size() == 0;
        allow delete: if false;
      }
    }

    function validOperation() {
      let d = request.resource.data;
      return d.keys().hasAll(['kind', 'epochDay', 'delta', 'createdAt'])
        && d.kind in ['COUNT_DELTA', 'BASELINE']
        // A single operation is bounded. A tap is 1 and an undo is -1; a baseline carries a whole
        // history, so the ceiling is generous but finite — an unbounded delta would let one
        // client move the worldwide figure arbitrarily.
        && d.delta is int
        && d.delta >= -1000
        && d.delta <= 100000000
        && d.epochDay is int
        && d.epochDay > 0;
    }

    // The worldwide figures. Readable by anyone signed in, writable by nobody: the only writer is
    // the aggregation function, running with Admin credentials.
    match /aggregates/{document} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
